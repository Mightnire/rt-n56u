+
+    for (i = 0; i < n; ++i) {
+        if (data->torrents[i]->queuePosition != i) {
+            data->torrents[i]->queuePosition = i;
+            tr_torrentSetDirty(data->torrents[i]);
+        }
+    }
+
     if (n != 0) {
         tr_logAddInfo(_("Loaded %d torrents"), n);
     }
